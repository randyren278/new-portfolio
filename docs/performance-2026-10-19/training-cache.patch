+/** Share the whole read/populate operation among same-process callers. */
+export function cached<T>(key: string, maxAgeSec: number, fetch: () => Promise<T>): Promise<T> {
+  const hit = pending.get(key);
+  if (hit) return hit as Promise<T>;
