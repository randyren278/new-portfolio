# =====================================================
# Randy's studio shell — environment variables
# Copy this to `.env.local` and fill in the real values.
# .env.local is git-ignored; never commit real secrets.
# =====================================================

# ---- Strava OAuth ----
# Create an app at https://www.strava.com/settings/api
# The "Authorization Callback Domain" there must be `localhost` for dev
# and your production hostname for prod.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3877/api/strava/callback

# ---- Token persistence — LOCAL DEV ----
# Path to a JSON file where the current (access, refresh) token pair is
# stored. Set this in local dev only. When unset, the app uses Edge Config
# (see below). File is git-ignored via .gitignore.
STRAVA_TOKEN_FILE=./.strava-tokens.json

# ---- Token persistence — PRODUCTION (Vercel) ----
# Leave these unset locally. On Vercel, add the Edge Config integration
# (which injects EDGE_CONFIG automatically), then set the two below.
# EDGE_CONFIG=                        # auto-injected by Vercel integration
# EDGE_CONFIG_ID=ecfg_xxxxxxxxxxxxx   # from the integration settings page
# VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxxx  # a personal access token, scope: full
# VERCEL_TEAM_ID=team_xxxxxxxxxxxx    # optional; only if the project lives in a team
